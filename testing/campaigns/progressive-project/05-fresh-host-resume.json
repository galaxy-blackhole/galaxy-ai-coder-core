      } }],
      "finishReason": "tool_calls"
    },
    {
      "toolCalls": [{ "toolCallId": "c05-checkpoint-read", "toolName": "update_checkpoint", "arguments": { "action": "read" } }],
      "finishReason": "tool_calls"
    },
    {
      "toolCalls": [{ "toolCallId": "c05-validate", "toolName": "validate_project", "arguments": { "checks": ["test"], "path": "." } }],
      "finishReason": "tool_calls"
    },
    {
      "toolCalls": [{ "toolCallId": "c05-diff", "toolName": "git_operation", "arguments": { "action": "diff", "paths": ["docs/usage.md"] } }],
      "finishReason": "tool_calls"
    },
    {
      "content": "The fresh host restored the durable checkpoint and lazy Git registry state without repeating inspection. Tests passed and the documentation diff was reviewed.",
      "finishReason": "stop"
    }
