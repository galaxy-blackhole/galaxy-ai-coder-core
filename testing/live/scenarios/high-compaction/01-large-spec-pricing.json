      "path": "tests/tiers.test.mjs",
      "content": "import assert from 'node:assert/strict';\nimport test from 'node:test';\nimport { tierFor, TIER_RATES } from '../src/tiers.mjs';\n\ntest('quantity tiers use inclusive lower bounds', () => {\n  assert.equal(tierFor(0), 'standard');\n  assert.equal(tierFor(49), 'standard');\n  assert.equal(tierFor(50), 'gold');\n  assert.equal(tierFor(99), 'gold');\n  assert.equal(tierFor(100), 'platinum');\n});\n\ntest('tier rates match the specification', () => {\n  assert.deepEqual(TIER_RATES, { platinum: 0.1, gold: 0.05, standard: 0 });\n});\n"
    },
    {
      "path": "tests/pricing.test.mjs",
      "content": "import assert from 'node:assert/strict';\nimport test from 'node:test';\nimport { quote } from '../src/pricing.mjs';\n\ntest('platinum with gold membership uses the specified order of operations', () => {\n  const result = quote([{ sku: 'A', priceCents: 1000, quantity: 120 }], { membership: 'gold' });\n  assert.deepEqual(result, {\n    subtotalCents: 120000,\n    discountCents: 12000,\n    surchargeCents: 5400,\n    totalCents: 113400,\n  });\n});\n\ntest('gold tier with silver membership rounds the surcharge half up once', () => {\n  const result = quote([{ sku: 'A', priceCents: 250, quantity: 50 }], { membership: 'silver' });\n  assert.deepEqual(result, {\n    subtotalCents: 12500,\n    discountCents: 625,\n    surchargeCents: 238,\n    totalCents: 12113,\n  });\n});\n\ntest('standard tier with silver membership and no membership default', () => {\n  const silver = quote([{ sku: 'A', priceCents: 100, quantity: 10 }], { membership: 'silver' });\n  assert.deepEqual(silver, { subtotalCents: 1000, discountCents: 0, surchargeCents: 20, totalCents: 1020 });\n  const plain = quote([{ sku: 'A', priceCents: 999, quantity: 3 }]);\n  assert.deepEqual(plain, { subtotalCents: 2997, discountCents: 0, surchargeCents: 0, totalCents: 2997 });\n});\n\ntest('multiple lines share one tier and invalid lines fail with the index', () => {\n  const multi = quote([\n    { sku: 'A', priceCents: 500, quantity: 60 },\n    { sku: 'B', priceCents: 400, quantity: 40 },\n  ], {});\n  assert.equal(multi.subtotalCents, 46000);\n  assert.equal(multi.discountCents, 4600);\n  assert.equal(multi.totalCents, 41400);\n  assert.throws(() => quote([{ sku: 'A', priceCents: -1, quantity: 1 }]), /index 0/);\n  assert.throws(() => quote([]), /items/i);\n});\n"
    },
